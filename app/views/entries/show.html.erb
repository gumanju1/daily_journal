<h1 class="page-title"><%= @entry.title %></h1>

<div class="entry-card">

  <% if @entry.photo.attached? %>
    <%= image_tag @entry.photo.url,
                  class: "journal-photo",
                  alt: @entry.title %>
  <% end %>

  <div class="entry-info">

    <p>
      <span class="mood-badge">
        😊 <%= @entry.mood %>
      </span>
    </p>

    <h3>📝 Journal</h3>

    <p class="journal-content">
      <%= simple_format(@entry.content) %>
    </p>

    <div class="entry-meta">
      <p>📅 Created: <%= @entry.created_at.strftime("%d %B %Y, %I:%M %p") %></p>
      <p>✏ Updated: <%= @entry.updated_at.strftime("%d %B %Y, %I:%M %p") %></p>
    </div>

  </div>

  <hr>

  <div class="comments-section">

    <h2>💬 Comments</h2>

    <% if @entry.comments.any? %>

      <% @entry.comments.each do |comment| %>

        <div class="comment-card">

          <strong><%= comment.user.name %></strong>

          <small>
            • <%= comment.created_at.strftime("%d %b %Y %I:%M %p") %>
          </small>

          <p><%= comment.content %></p>

          <% if comment.user == current_user %>
            <%= button_to "Delete Comment",
                          entry_comment_path(@entry, comment),
                          method: :delete,
                          class: "delete-btn",
                          data: {
                            turbo_confirm: "Delete this comment?"
                          } %>
          <% end %>

        </div>

      <% end %>

    <% else %>

      <p>No comments yet.</p>

    <% end %>

    <hr>

    <h3>Add a Comment</h3>

    <%= form_with model: [@entry, Comment.new] do |form| %>

      <%= form.text_area :content,
          rows: 4,
          placeholder: "Write your comment..." %>

      <br><br>

      <%= form.submit "Post Comment" %>

    <% end %>

  </div>

  <hr>

  <div class="sharing-section">

    <h3>🔗 Share This Journal</h3>

    <%= form_with url: entry_entry_shares_path(@entry), method: :post do |form| %>

      <%= form.email_field :email,
          placeholder: "Enter user's email",
          required: true %>

      <%= form.submit "Share Journal" %>

    <% end %>

    <% if @entry.shared_users.any? %>

      <h4>Shared with:</h4>

      <% @entry.shared_users.each do |user| %>

        <p>
          <%= user.name %> (<%= user.email %>)
        </p>

      <% end %>

    <% end %>

  </div>

  <hr>

  <div class="actions">

    <%= link_to "⬅ Back",
                entries_path,
                class: "secondary-btn" %>

    <%= link_to "✏ Edit",
                edit_entry_path(@entry),
                class: "primary-btn" %>

    <%= button_to "🗑 Delete Entry",
                  entry_path(@entry),
                  method: :delete,
                  class: "delete-btn",
                  data: {
                    turbo_confirm: "Are you sure you want to delete this journal entry?"
                  } %>

  </div>

</div>