<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Daily Journal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Daily Journal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav style="background:#2c3e50; padding:15px;">
      <% if current_user %>
        <%= link_to "Home", entries_path, style: "color:white; margin-right:20px; text-decoration:none;" %>

        <span style="color:white; margin-right:20px;">
          Welcome, <%= current_user.name %>
        </span>

        <%= button_to "Logout",
                      logout_path,
                      method: :delete,
                      form: { style: "display:inline;" },
                      style: "background:#e74c3c; color:white; border:none; padding:8px 12px; cursor:pointer;" %>
      <% else %>
        <%= link_to "Login", login_path, style: "color:white; margin-right:20px; text-decoration:none;" %>
        <%= link_to "Sign Up", signup_path, style: "color:white; text-decoration:none;" %>
      <% end %>
    </nav>

    <% if notice %>
      <p style="color:green; padding:10px;"><%= notice %></p>
    <% end %>

    <% if alert %>
      <p style="color:red; padding:10px;"><%= alert %></p>
    <% end %>

    <%= yield %>

  </body>
</html>