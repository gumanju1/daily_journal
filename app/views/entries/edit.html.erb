<h1>Edit Journal Entry</h1>

<% if @entry.errors.any? %>
  <div style="color: red;">
    <h3>
      <%= pluralize(@entry.errors.count, "error") %> prohibited this journal entry from being saved:
    </h3>

    <ul>
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <br>

  <div>
    <%= form.label :content %><br>
    <%= form.text_area :content, rows: 6 %>
  </div>

  <br>

  <div>
    <%= form.label :mood %><br>
    <%= form.select :mood, [
      "Happy",
      "Calm",
      "Excited",
      "Sad",
      "Stressed",
      "Angry"
    ] %>
  </div>

  <br>

  <% if @entry.photo.attached? %>
    <div>
      <strong>Current Photo:</strong><br><br>
      <%= image_tag @entry.photo, width: 250, style: "border-radius: 10px;" %>
    </div>

    <br>
  <% end %>

  <div>
    <%= form.label :photo, "Change Photo" %><br>
    <%= form.file_field :photo, accept: "image/*" %>
  </div>

  <br>

  <div>
    <%= form.submit "Update Entry" %>
  </div>

<% end %>