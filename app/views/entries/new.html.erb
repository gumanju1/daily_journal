<h1 class="page-title">📝 Create New Journal Entry</h1>

<% if @entry.errors.any? %>
  <div style="background:#fee2e2; color:#b91c1c; padding:20px; border-radius:10px; margin-bottom:25px;">
    <h3>
      <%= pluralize(@entry.errors.count, "error") %> prevented this journal entry from being saved:
    </h3>

    <ul>
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title,
        placeholder: "Enter journal title",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :content %><br>
    <%= form.text_area :content,
        rows: 8,
        placeholder: "Write about your day, thoughts, or memories...",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :mood %><br>
    <%= form.select :mood,
      [
        "😊 Happy",
        "😌 Calm",
        "🤩 Excited",
        "😢 Sad",
        "😓 Stressed",
        "😠 Angry"
      ],
      { prompt: "Select your mood" },
      { required: true } %>
  </div>

  <br>

  <div>
    <%= form.label :photo, "📷 Upload Photo" %><br>
    <%= form.file_field :photo, accept: "image/*" %>
  </div>

  <br>

  <div style="display:flex; gap:15px; align-items:center;">

    <%= form.submit "💾 Save Journal Entry" %>

    <%= link_to "⬅ Cancel",
                entries_path,
                class: "secondary-btn" %>

  </div>

<% end %>