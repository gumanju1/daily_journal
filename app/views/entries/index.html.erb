<h1>My Journal Entries</h1>

<p><strong>Total Entries:</strong> <%= @entries.count %></p>

<p>
  <%= link_to "New Journal Entry", new_entry_path %>
</p>

<% if @entries.any? %>
  <% @entries.each do |entry| %>
    <div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
      <h3>
        <%= link_to entry.title, entry_path(entry) %>
      </h3>

      <p><strong>Mood:</strong> <%= entry.mood %></p>

      <p><%= truncate(entry.content, length: 100) %></p>

      <small>
        Created on: <%= entry.created_at.strftime("%d %b %Y") %>
      </small>

      <br><br>

      <%= link_to "View", entry_path(entry) %> |
      <%= link_to "Edit", edit_entry_path(entry) %> |
      <%= button_to "Delete",
                    entry_path(entry),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure you want to delete this journal entry?" } %>
    </div>
  <% end %>
<% else %>
  <p>No journal entries found. Create your first journal entry!</p>
<% end %>