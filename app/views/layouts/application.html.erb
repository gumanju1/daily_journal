<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Daily Journal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Daily Journal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav style="background:#2c3e50; padding:15px; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <% if current_user %>
          <%= link_to "Home", entries_path, style: "color:white; text-decoration:none; margin-right:20px;" %>
        <% end %>
      </div>

      <div>
        <% if current_user %>
          <span style="color:white; margin-right:15px;">
            Welcome, <%= current_user.name %>
          </span>

          <%= button_to "Logout",
                        logout_path,
                        method: :delete,
                        form: { style: "display:inline;" },
                        style: "background:#dc3545; color:white; border:none; padding:8px 15px; border-radius:5px; cursor:pointer;" %>
        <% else %>
          <%= link_to "Login", login_path, style: "color:white; margin-right:20px; text-decoration:none;" %>
          <%= link_to "Sign Up", signup_path, style: "color:white; text-decoration:none;" %>
        <% end %>
      </div>
    </nav>

    <% if notice %>
      <div id="toast" class="toast success">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div id="toast" class="toast error">
        <%= alert %>
      </div>
    <% end %>

    <%= yield %>

    <script>
      setTimeout(function() {
        const toast = document.getElementById("toast");
        if (toast) {
          toast.remove();
        }
      }, 3000);
    </script>

  </body>
</html>