<h1>New Journal Entry</h1>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :mood %>
    <%= form.select :mood, [
      "Happy",
      "Calm",
      "Excited",
      "Sad",
      "Stressed",
      "Angry"
    ] %>
  </div>

  <div>
    <%= form.submit "Save Entry" %>
  </div>

<% end %>