<h1 class="page-title">✏️ Edit Journal Entry</h1>

<% if @entry.errors.any? %>
  <div style="background:#fee2e2; color:#b91c1c; padding:20px; border-radius:10px; margin-bottom:25px;">
    <h3>
      <%= pluralize(@entry.errors.count, "error") %> prevented this journal entry from being updated:
    </h3>

    <ul>
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title,
        placeholder: "Enter journal title",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :content %><br>
    <%= form.text_area :content,
        rows: 8,
        placeholder: "Update your journal entry...",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :mood %><br>
    <%= form.select :mood,
      [
        "😊 Happy",
        "😌 Calm",
        "🤩 Excited",
        "😢 Sad",
        "😓 Stressed",
        "😠 Angry"
      ],
      {},
      { required: true } %>
  </div>

  <br>

  <div>
    <%= form.label :photo, "📷 Change Photo" %><br>
    <%= form.file_field :photo, accept: "image/*" %>
  </div>

  <% if @entry.photo.attached? %>
    <br>

    <strong>Current Photo</strong><br><br>

    <%= image_tag @entry.photo,
                  style: "max-width:300px; border-radius:10px;" %>
  <% end %>

  <br><br>

  <div style="display:flex; gap:15px; align-items:center;">

    <%= form.submit "💾 Update Journal Entry" %>

    <%= link_to "👁 View Entry",
                entry_path(@entry),
                class: "secondary-btn" %>

    <%= link_to "⬅ Back",
                entries_path,
                class: "secondary-btn" %>

  </div>

<% end %>