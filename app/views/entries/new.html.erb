<h1>New Journal Entry</h1>

<% if @entry.errors.any? %>
  <div style="color: red;">
    <h3>
      <%= pluralize(@entry.errors.count, "error") %> prohibited this journal entry from being saved:
    </h3>

    <ul>
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :mood %>
    <%= form.select :mood, [
      "Happy",
      "Calm",
      "Excited",
      "Sad",
      "Stressed",
      "Angry"
    ] %>
  </div>

  <div>
    <%= form.submit "Save Entry" %>
  </div>

<% end %>