<h1>Sign Up</h1>

<%= form_with model: @user, url: signup_path, local: true do |form| %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation %>
  </div>

  <div>
    <%= form.label :bio, "Short Introduction" %>
    <%= form.text_area :bio, placeholder: "Tell us a little about yourself..." %>
  </div>

  <div>
    <%= form.label :theme_preference, "Choose Theme" %>
    <%= form.select :theme_preference, [
      ["Light Mode", "light"],
      ["Dark Mode", "dark"],
      ["Minimal", "minimal"]
    ] %>
  </div>

  <div>
    <%= form.submit "Create Account" %>
  </div>

<% end %>

<% if current_user %>
  <p>Welcome, <%= current_user.name %></p>

  <%= button_to "Logout", logout_path, method: :delete %>
<% end %>

<p>
  Already have an account?
  <%= link_to "Log in", login_path %>
</p>