<h1>New Journal Entry</h1>

<% if @entry.errors.any? %>
  <div style="color: red;">
    <h3>
      <%= pluralize(@entry.errors.count, "error") %> prohibited this journal entry from being saved:
    </h3>

    <ul>
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry do |form| %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title,
        placeholder: "Enter journal title",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :content %><br>
    <%= form.text_area :content,
        rows: 6,
        placeholder: "Write about your day...",
        required: true %>
  </div>

  <br>

  <div>
    <%= form.label :mood %><br>
    <%= form.select :mood,
      [
        "Happy",
        "Calm",
        "Excited",
        "Sad",
        "Stressed",
        "Angry"
      ],
      { prompt: "Select your mood" },
      { required: true } %>
  </div>

  <br>

  <div>
    <%= form.submit "Save Entry" %>
  </div>

<% end %>