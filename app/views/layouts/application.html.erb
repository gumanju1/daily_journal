<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Daily Journal" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Daily Journal">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav class="navbar">

      <div class="nav-left">
        <% if current_user %>
          <%= link_to "📖 Daily Journal", entries_path %>
        <% else %>
          <strong style="color:white;font-size:22px;">
            📖 Daily Journal
          </strong>
        <% end %>
      </div>

      <div class="nav-right">

        <% if current_user %>

          <span style="color:white;margin-right:20px;">
            👋 Welcome,
            <strong><%= current_user.name %></strong>
          </span>

          <%= link_to "🏠 Home",
                      entries_path,
                      class: "secondary-btn",
                      style: "margin-right:10px;" %>

          <%= link_to "➕ New Journal",
                      new_entry_path,
                      class: "primary-btn",
                      style: "margin-right:10px;" %>

          <%= button_to "Logout",
                        logout_path,
                        method: :delete,
                        form: { style: "display:inline;" },
                        class: "delete-btn" %>

        <% else %>

          <%= link_to "Login",
                      login_path,
                      class: "secondary-btn",
                      style: "margin-right:10px;" %>

          <%= link_to "Sign Up",
                      signup_path,
                      class: "primary-btn" %>

        <% end %>

      </div>

    </nav>

    <% if notice %>
      <div id="toast" class="toast success">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div id="toast" class="toast error">
        <%= alert %>
      </div>
    <% end %>

    <div class="container">
      <%= yield %>
    </div>

    <script>
      setTimeout(function () {
        const toast = document.getElementById("toast");

        if (toast) {
          toast.remove();
        }
      }, 3000);
    </script>

  </body>
</html>