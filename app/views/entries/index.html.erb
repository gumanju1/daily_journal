<h1 class="page-title">📖 My Journal Entries</h1>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">

  <h3>
    Total Entries:
    <span class="mood-badge">
      <%= @entries.count %>
    </span>
  </h3>

  <%= link_to "➕ New Journal Entry",
              new_entry_path,
              class: "primary-btn" %>

</div>

<% if @entries.any? %>

  <% @entries.each do |entry| %>

    <div class="entry-card">

      <% if entry.photo.attached? %>
        <%= image_tag entry.photo %>
      <% end %>

      <h2 class="entry-title">
        <%= link_to entry.title, entry_path(entry) %>
      </h2>

      <p>
        <span class="mood-badge">
          😊 <%= entry.mood %>
        </span>
      </p>

      <p style="margin-top:15px;">
        <%= truncate(entry.content, length: 150) %>
      </p>

      <p class="entry-meta">
        📅
        <%= entry.created_at.strftime("%d %B %Y") %>
      </p>

      <div class="actions">

        <%= link_to "👁 View",
                    entry_path(entry),
                    class: "secondary-btn" %>

        <%= link_to "✏ Edit",
                    edit_entry_path(entry),
                    class: "primary-btn" %>

        <%= button_to "🗑 Delete",
                      entry_path(entry),
                      method: :delete,
                      class: "delete-btn",
                      data: {
                        turbo_confirm: "Are you sure you want to delete this journal entry?"
                      } %>

      </div>

    </div>

  <% end %>

<% else %>

  <div class="empty-state">

    <h2>No Journal Entries Yet 📔</h2>

    <p>
      Start recording your memories today.
    </p>

    <br>

    <%= link_to "Create Your First Journal",
                new_entry_path,
                class: "primary-btn" %>

  </div>

<% end %>