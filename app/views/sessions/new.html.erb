<h1>Login</h1>

<%= form_with url: login_path, method: :post, local: true do |form| %>

  <p>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
  </p>

  <p>
    <%= form.label :password %><br>
    <%= form.password_field :password %>
  </p>

  <p>
    <%= form.submit "Login", style: "padding: 10px 20px; font-size: 18px; cursor: pointer;" %>
  </p>

<% end %>