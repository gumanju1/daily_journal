<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Daily Journal" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Daily Journal">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

  <nav class="navbar">
  <% if current_user %>
    <div class="nav-center">
      <span class="welcome-text">
        👋 Welcome,
        <strong><%= current_user.name.presence || current_user.email %></strong>
      </span>

      <%= link_to "🏠 Home",
                  entries_path,
                  class: "secondary-btn" %>

      <%= link_to "➕ New Journal",
                  new_entry_path,
                  class: "primary-btn" %>
    </div>

    <div class="nav-logout">
      <%= button_to "Logout",
                    destroy_user_session_path,
                    method: :delete,
                    form: { style: "display:inline;" },
                    class: "delete-btn" %>
    </div>

  <% else %>
    <div class="nav-right">
      <%= link_to "Login",
                  new_user_session_path,
                  class: "secondary-btn" %>

      <%= link_to "Sign Up",
                  new_user_registration_path,
                  class: "primary-btn" %>
    </div>
  <% end %>
</nav>

<% if notice %>
  <div id="toast" class="toast success">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div id="toast" class="toast error">
    <%= alert %>
  </div>
<% end %>

<div class="container">
  <%= yield %>
</div>

<script>
  setTimeout(function () {
    const toast = document.getElementById("toast");

    if (toast) {
      toast.remove();
    }
  }, 3000);
</script>