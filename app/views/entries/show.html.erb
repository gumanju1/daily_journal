<h1 class="page-title"><%= @entry.title %></h1>

<div class="entry-card">

  <p>
    <span class="mood-badge">
      😊 <%= @entry.mood %>
    </span>
  </p>

  <% if @entry.photo.attached? %>

    <%= image_tag @entry.photo %>

  <% end %>

  <hr>

  <h3>📝 Journal</h3>

  <p style="line-height:1.8;">
    <%= simple_format(@entry.content) %>
  </p>

  <hr>

  <p class="entry-meta">
    📅 Created:
    <%= @entry.created_at.strftime("%d %B %Y, %I:%M %p") %>
  </p>

  <p class="entry-meta">
    ✏ Updated:
    <%= @entry.updated_at.strftime("%d %B %Y, %I:%M %p") %>
  </p>

  <hr>

  <div class="actions">

    <%= link_to "⬅ Back",
                entries_path,
                class: "secondary-btn" %>

    <%= link_to "✏ Edit",
                edit_entry_path(@entry),
                class: "primary-btn" %>

    <%= button_to "🗑 Delete",
                  entry_path(@entry),
                  method: :delete,
                  class: "delete-btn",
                  data: {
                    turbo_confirm: "Are you sure you want to delete this journal entry?"
                  } %>

  </div>

</div>